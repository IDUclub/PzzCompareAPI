# Template for local dev (.env.development) and production environments.
# Copy to .env.development and fill real values. Do NOT commit the filled file.

# ── Database & broker ────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/pzz_pipeline
REDIS_URL=redis://localhost:6379/0

# ── LLM backend ──────────────────────────────────────────────────────────────
LLM_BACKEND=vllm
OLLAMA_BASE_URL=http://your-llm-host:11434
VLLM_BASE_URL=http://your-vllm-host:8000
VLLM_API_KEY=
EMBED_MODEL=intfloat/e5-mistral-7b-instruct
# Must be the name the backend serves under, not the weights path:
# for vLLM that is --served-model-name, which may differ from the HF repo id.
GENERATE_MODEL=gpt-oss-20b
VECTORIZER_URL=http://your-vectorizer-host:8002/v1/embeddings

# ── ChatStorage integration (IDUclub ChatStorage service) ────────────────────
# Stores assistant chat history. Leave empty to disable persistence (the
# conversational /chat/stream flow still streams the answer, just doesn't save).
CHAT_STORAGE_BASE_URL=http://10.32.1.99:8010
CHAT_STORAGE_TIMEOUT_SECONDS=10
# Conversational answer over classification results, streamed back to the user.
# Follows LLM_BACKEND (above), so it talks to VLLM_BASE_URL or OLLAMA_BASE_URL;
# the model is chosen per request. CHAT_MODEL is the default model when the
# request omits one (falls back to GENERATE_MODEL).
CHAT_MODEL=
CHAT_TEMPERATURE=0.3
CHAT_REQUEST_TIMEOUT_SECONDS=900
CHAT_SYSTEM_PROMPT_PATH=data/chat_system_prompt.txt
# Result GeoJSON is offered as a durable link (/files/result/{id} → 302 to a
# fresh presigned MinIO URL). PUBLIC_BASE_URL makes the stored link absolute
# (e.g. https://api.example.org); leave empty to store a relative path.
PUBLIC_BASE_URL=
GEO_LAYER_URL_TTL_SECONDS=3600

# ── urban_api integration ────────────────────────────────────────────────────
# IDU urban_api base URL. Leave empty to disable /scenarios/* endpoints.
URBAN_API_BASE_URL=
URBAN_API_TIMEOUT_SECONDS=30

# ── Bearer-token verification (Keycloak JWT via JWKS) ────────────────────────
# AUTH_VERIFY=false accepts tokens without signature checks (dev, or when an
# upstream gateway already validated them). Set true + AUTH_SERVER_URL in prod.
# AUTH_SERVER_URL = https://<host>/realms/<realm>
AUTH_VERIFY=false
AUTH_SERVER_URL=
AUTH_CLIENT_ID=
AUTH_VERIFY_AUD=true
# AUTH_VALID_AUDIENCES = comma-separated list
AUTH_VALID_AUDIENCES=
AUTH_JWKS_CACHE_TTL=600
AUTH_USER_CACHE_TTL=300
AUTH_USER_CACHE_SIZE=10000
AUTH_TIMEOUT_SECONDS=5

# ── Keycloak service token (outbound M2M auth to ChatStorage) ────────────────
# Chat history is persisted with OUR service-account token (client_credentials),
# not the user's token — the user's token expires during long computations. The
# end user is identified to ChatStorage via the X-User-Id header (their sub,
# captured from the frontend token at request start). Leave empty to disable the
# service token (chat history persistence is then off).
# KEYCLOAK_URL = base URL (no /realms suffix), e.g. https://keycloak.idu.actcognitive.org
KEYCLOAK_URL=
KEYCLOAK_REALM=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
# KEYCLOAK_SCOPE = optional OAuth2 scope
KEYCLOAK_SCOPE=

# ── Object storage (MinIO / S3-compatible) ───────────────────────────────────
# Leave ACCESS_KEY and SECRET_KEY empty to fall back to local filesystem.
FILESERVER_ENDPOINT=
FILESERVER_ACCESS_KEY=
FILESERVER_SECRET_KEY=
FILESERVER_BUCKET_NAME=
FILESERVER_SECURE=false

# ── Pipeline tuning ──────────────────────────────────────────────────────────
TOP_K=10
EMBED_BATCH_SIZE=64
# Disk cache of embedding vectors, keyed by model + exact text. Every pipeline
# run re-embeds the same static VRI catalogue and the same VRI phrasings, and
# the embedder is the run's bottleneck, so this is the main speed-up. Point it
# at a directory shared by all workers; empty disables the cache. Entries are
# never evicted — drop the directory to reclaim the space.
EMBED_CACHE_DIR=/app/embed_cache

# Disk cache of the model's structured answers, keyed on the rendered question
# (model + decoding params + system prompt + schema + user prompt), never on the
# input file. Two municipalities sharing a zone code cannot collide because the
# regulation text is part of the prompt; changing prompt, model or schema misses
# instead of reusing a stale answer. Empty disables it. Failed calls are never
# stored. Makes repeat runs reproducible, which single runs are not: the backend
# still varies on ~8% of answers at temperature=0 because of continuous batching.
# Each entry keeps the question it answers, so a reused verdict can be inspected
# and re-asked; expect roughly 15 MB per municipality.
LLM_CACHE_DIR=/app/llm_cache
# How long an answer may be reused, in days. 0 keeps answers forever; set a small
# value to bound how long a wrong answer can survive without dropping the cache.
LLM_CACHE_TTL_DAYS=0
CADASTRAL_VRI_COL=Вид разреш
TOP_N_EMBED_CANDIDATES=5
TOP_N_EMBED_CANDIDATES_HARD=8
MIN_EMBED_CANDIDATE_SIMILARITY=0.52
# Semantic pre-match of a parcel VRI against the allowed VRI of its own zone.
# Off by default: it embeds every VRI item of every zone before the run starts,
# which costs far more than the LLM zone check it short-circuits.
ENABLE_ZONE_ITEM_EMBED_MATCH=false
# Ignore boundary-only contacts and numeric slivers in spatial PZZ matching.
SPATIAL_MIN_POLYGON_INTERSECTION_AREA_M2=1.0
SPATIAL_MIN_LINE_INTERSECTION_LENGTH_M=0.01
SPATIAL_MIN_INTERSECTION_SHARE=0.000001
PRIORITY_MAX_SUM_DEFAULT=20
